# Copy to .dev.vars for `pywrangler dev`. Not used in production: set real
# values with `npx wrangler secret put <NAME>` (secrets) or in wrangler.jsonc
# (vars).

# Refresh token for an anonymous Firebase account in the coreapp project,
# required by the cron. Mint one with the accounts:signUp call in the README.
CORE_DASH_REFRESH_TOKEN=

# Optional: a second account, enrolled in the beta programme. eng-dash answers
# by the asking account's track, so this one's builds land on `beta`. Leave it
# empty and that channel skips.
CORE_DASH_REFRESH_TOKEN_BETA=

# Memfault project key. Only needed if you point the cron back at memfault.py.
MEMFAULT_TOKEN=

# Optional: the serial the cron reports upstream. The Core Devices dash answers
# per device, so this picks which build we are offered.
# DEVICE_SERIAL=REBBLE_COHORTS_CRON

# Optional: point a poller at a stand-in upstream while developing.
# CORE_DASH_API=http://127.0.0.1:5005/api/ota/latest
# MEMFAULT_API=http://127.0.0.1:5004/api/v0/releases/latest
