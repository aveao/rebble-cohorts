{
  "name": "rebble-cohorts",
  "main": "src/entry.py",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },

  // The landing page is served straight from assets, ahead of the Worker, so
  // viewing it costs no invocation. Paths with no matching file, /cohort and
  // the rest, fall through to the Worker.
  "assets": { "directory": "./public" },

  // FIRMWARE_ROOT is the public base URL for firmware blobs, and must line up
  // with whatever custom domain is attached to the R2 bucket below: the cron
  // writes objects at R2_PREFIX/<hardware>/<file> and stores
  // FIRMWARE_ROOT/<hardware>/<file> in the database.
  //
  // DEVICE_SERIAL is the serial the cron reports upstream. Memfault only logs
  // it, but the Core Devices dash answers per device, so changing it changes
  // which build we are offered.
  //
  // CORE_DASH_FIREBASE_KEY is a Firebase Web API key: a public client
  // identifier rather than a secret, hence a var. This is CoreApp's own.
  "vars": {
    "FIRMWARE_ROOT": "https://cohorts-storage.lavate.ch/fw",
    "R2_PREFIX": "fw/",
    "DEVICE_SERIAL": "REBBLE_COHORTS_CRON",
    "CORE_DASH_FIREBASE_KEY": "AIzaSyD-xpPFNkplPF-_DOS1jFCMILg_7yPwHqA"
  },

  // The credentials are secrets, not vars:
  //   npx wrangler secret put CORE_DASH_REFRESH_TOKEN       (canonical track)
  //   npx wrangler secret put CORE_DASH_REFRESH_TOKEN_BETA  (beta track, optional)
  //   npx wrangler secret put MEMFAULT_TOKEN                (fallback poller)

  // No database_id: wrangler provisions the database on first deploy and writes
  // the id back here. The binding stays linked on later deploys either way.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cohorts",
      "migrations_dir": "migrations"
    }
  ],

  // bucket_name is explicit because it is public-facing, a custom domain points
  // at it and firmware URLs are stored in the database. Omitting it would let
  // wrangler provision a bucket under a generated, worker-prefixed name instead.
  "r2_buckets": [
    {
      "binding": "BINARIES",
      "bucket_name": "cohorts"
    }
  ],

  // Hourly, polling every CoreDevice in the one invocation. Keep the interval
  // at an hour or longer: cron invocations at shorter intervals are capped at
  // 30s CPU, while >=1h gets 15 minutes.
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
